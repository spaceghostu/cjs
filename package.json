{
	"name": "cjs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run --project unit",
		"test:mobile": "vitest run --project mobile",
		"test:stories": "vitest run --project stories-light --project stories-dark",
		"e2e": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"db:dev": "bun run scripts/dev-db.ts start",
		"db:dev:stop": "bun run scripts/dev-db.ts stop",
		"db:dev:reset": "bun run scripts/dev-db.ts reset",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"test:money": "vitest run --project unit --coverage.enabled --coverage.include='src/lib/core/money/**' --coverage.exclude='src/lib/core/money/*.test.ts' --coverage.exclude='src/lib/core/money/index.ts'"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.28.0",
		"better-auth": "^1.6.25",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"fflate": "^0.8.3",
		"mode-watcher": "^1.1.0",
		"nodemailer": "^9.0.3",
		"pg": "^8.22.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.2.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@storybook/addon-a11y": "^10.5.5",
		"@storybook/addon-docs": "^10.5.5",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.5.5",
		"@storybook/sveltekit": "^10.5.5",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@types/nodemailer": "^8.0.1",
		"@types/pg": "^8.20.1",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"auth": "^1.6.23",
		"drizzle-kit": "^0.31.10",
		"embedded-postgres": "^18.4.0-beta.17",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.5.5",
		"eslint-plugin-svelte": "^3.19.0",
		"fast-check": "^4.9.0",
		"globals": "^17.6.0",
		"playwright": "^1.62.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.4.2",
		"storybook": "^10.5.5",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"trustedDependencies": [
		"@embedded-postgres/linux-x64"
	]
}
