# ── Database ──────────────────────────────────────────────────────────────────────────
# Postgres must be physically in South Africa: SARS GN 787 rule 4.1 requires electronic
# tax records to be kept in the Republic, and rule 4.2's exemption needs a per-taxpayer
# SARS authorisation that does not scale to self-service signup.
#
# TWO roles, deliberately. FORCE ROW LEVEL SECURITY does not apply to a table's owner, to
# a superuser, or to a role with BYPASSRLS — so if the application connected as any of
# those, every tenant policy would be decorative and businesses could read each other's
# invoices while everything appeared to work. The app boots with an assertion that its
# role is none of them.

# The APPLICATION role. Owns nothing. NOSUPERUSER, NOBYPASSRLS.
DATABASE_URL="postgres://cjs_app:cjs_app@127.0.0.1:5433/cjs"
# The DDL role. Owns the schema. Used only by drizzle-kit.
DATABASE_MIGRATION_URL="postgres://cjs_owner:cjs_owner@127.0.0.1:5433/cjs"
# Optional. See the fan-out note in src/lib/server/core/db/client.ts before raising it.
DATABASE_POOL_MAX="10"

# For local development, `bun run db:dev` starts a real Postgres in userspace (no Docker,
# no sudo) and prints exactly these two URLs.

# ── App ───────────────────────────────────────────────────────────────────────────────
# REQUIRED. adapter-node rejects every form POST without it ("Cross-site POST form
# submissions are forbidden"), which breaks every commit path in the product.
ORIGIN="http://localhost:5173"

# 32+ characters of high-entropy random. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# ── Sign-in providers (optional — set both halves of a pair, or neither) ──────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ── Outbound mail (optional — needed for magic-link sign-in and document delivery) ────
# Without these, magic links are printed to the server console in development and refused
# in production. Never silently dropped.
SMTP_URL=""
MAIL_FROM=""

# ── Tests ─────────────────────────────────────────────────────────────────────────────
# Vitest sets NODE_ENV=test, and Bun does NOT load `.env.local` in that mode — so a
# checkout whose `.env` points DATABASE_URL at the owner role (the role migrations need)
# would run the WHOLE suite as a role holding BYPASSRLS. Every tenancy assertion in the
# repo would then pass by walking around the policies rather than through them.
#
# Create a local, uncommitted `.env.test` carrying the application role and nothing else:
#
#     grep '^DATABASE_URL=' .env.local > .env.test
#
# `scripts/vitest-setup.ts` refuses to let the suite start if this is wrong, so the
# failure is loud rather than a silently vacuous green run.
